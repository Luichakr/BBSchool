# ── Przelewy24 (P24) ───────────────────────────────────────────────
# Get these from the P24 merchant panel. CRC + API_KEY are SECRET —
# never commit them. Put real values in .env.local (gitignored) and in
# Vercel → Project → Settings → Environment Variables.
P24_MERCHANT_ID=
P24_POS_ID=           # usually same as merchant id
P24_CRC=              # secret
P24_API_KEY=          # secret (klucz do raportów / REST API)
P24_SANDBOX=true      # true = sandbox.przelewy24.pl ; false = live

# Optional: public origin used for P24 return/status URLs
# NEXT_PUBLIC_ACADEMY_ORIGIN=https://academy.bidbidders.com
